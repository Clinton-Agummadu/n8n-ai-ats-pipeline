    {
      "parameters": {
        "jsCode": "// Get the raw text returned from the Basic LLM Chain node\nconst rawText = $input.item.json.text;\n\n// Clean up markdown code blocks if the AI included them\nlet cleanJsonString = rawText.replace(/```json/g, '').replace(/```/g, '').trim();\n\n// Parse it into a real JSON object\nconst parsedData = JSON.parse(cleanJsonString);\n\n// Return the parsed fields so they show up as individual properties\nreturn [{ json: parsedData }];"
      },
